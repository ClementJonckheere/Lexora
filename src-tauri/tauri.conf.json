{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lexora",
  "version": "2.12.0",
  "identifier": "com.clementjonckheere.lexora",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lexora",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "backgroundColor": "#FAFAF9",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; media-src 'self' blob: data: https://upload.wikimedia.org; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Education",
    "shortDescription": "Carnet de vocabulaire anglais et répétition espacée",
    "longDescription": "Lexora enregistre en quelques secondes le vocabulaire anglais que vous découvrez, l'organise automatiquement et vous le fait réviser au bon moment grâce à l'algorithme FSRS. 100 % local et hors ligne.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "fr-FR"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxMTBFOUVGMTZENDQ4Q0IKUldUTFNOUVc3K2tRMFVjTlI2Q0dtY3Z5dGV6bDJMVTJhRDFYTTlmU1dKa3JoOXRBT3BKc1Z1MjUK",
      "endpoints": [
        "https://github.com/ClementJonckheere/Lexora/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
