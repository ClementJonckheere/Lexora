ly","quick"],"form":"adverb"},{"id":"adverbs-manner:36910","en":"Please shuffle the cards carefully.","fr":"Veuillez mélanger les cartes avec soin.","before":"Please shuffle the cards ","after":".","answer":"carefully","choices":["carefully","careful"],"form":"adverb"},{"id":"adverbs-manner:5252823","en":"I don't take my job lightly.","fr":"Je ne prends pas mon travail à la légère.","before":"I don't take my job ","after":".","answer":"lightly","choices":["lightly","light"],"form":"adverb"},{"id":"adverbs-manner:6958628","en":"She knows I love her deeply.","fr":"Elle sait que je l'aime profondément.","before":"She knows I love her ","after":".","answer":"deeply","choices":["deeply","deep"],"form":"adverb"},{"id":"adverbs-manner:797460","en":"Misfortunes rarely come singly.","fr":"Un malheur n'arrive jamais seul.","before":"Misfortunes rarely come ","after":".","answer":"singly","choices":["singly","sing"],"form":"adverb"},{"id":"adverbs-manner:1637665","en":"Write carefully and legibly.","fr":"Écris avec soin et lisiblement.","before":"Write carefully and ","after":".","answer":"legibly","choices":["legibly","legible"],"form":"adverb"},{"id":"adverbs-manner:587174","en":"He speaks French fluently.","fr":"Il parle le français couramment.","before":"He speaks French ","after":".","answer":"fluently","choices":["fluently","fluent"],"form":"adverb"},{"id":"adverbs-manner:288240","en":"His knowledge of Chinese enabled us to carry out our plan smoothly.","fr":"Sa connaissance du chinois nous permit de dérouler notre plan aisément.","before":"His knowledge of Chinese enabled us to carry out our plan ","after":".","answer":"smoothly","choices":["smoothly","smooth"],"form":"adverb"},{"id":"adverbs-manner:2451547","en":"Tom speaks French perfectly.","fr":"Tom parle parfaitement français.","before":"Tom speaks French ","after":".","answer":"perfectly","choices":["perfectly","perfect"],"form":"adverb"},{"id":"adverbs-manner:2645284","en":"Tom speaks very quickly.","fr":"Tom parle très vite.","before":"Tom speaks very ","after":".","answer":"quickly","choices":["quickly","quick"],"form":"adverb"},{"id":"adverbs-manner:2358577","en":"It went off smoothly.","fr":"Ça s'est passé comme prévu.","before":"It went off ","after":".","answer":"smoothly","choices":["smoothly","smooth"],"form":"adverb"},{"id":"adverbs-manner:3232181","en":"He listened to his old punk records nostalgically.","fr":"Il écoutait ses vieux vinyles punk avec nostalgie.","before":"He listened to his old punk records ","after":".","answer":"nostalgically","choices":["nostalgically","nostalgic"],"form":"adverb"},{"id":"adverbs-manner:243977","en":"I had stage fright at first, but I got over it quickly.","fr":"Au début, j'avais le trac, mais je l'ai rapidement surmonté.","before":"I had stage fright at first, but I got over it ","after":".","answer":"quickly","choices":["quickly","quick"],"form":"adverb"},{"id":"adverbs-manner:1707","en":"Speak more slowly, please!","fr":"Parlez plus lentement s'il vous plaît !","before":"Speak more ","after":", please!","answer":"slowly","choices":["slowly","slow"],"form":"adverb"},{"id":"adverbs-manner:441969","en":"Please say it more loudly.","fr":"Veuillez parler plus fort.","before":"Please say it more ","after":".","answer":"loudly","choices":["loudly","loud"],"form":"adverb"},{"id":"adverbs-manner:6537443","en":"Tom suffered bitterly.","fr":"Tom souffra amèrement.","before":"Tom suffered ","after":".","answer":"bitterly","choices":["bitterly","bitter"],"form":"adverb"},{"id":"adverbs-manner:1972589","en":"It's up to you to keep things running smoothly.","fr":"Il ne tient qu'à toi que les choses continuent à se dérouler en douceur.","before":"It's up to you to keep things running ","after":".","answer":"smoothly","choices":["smoothly","smooth"],"form":"adverb"},{"id":"adverbs-manner:11508905","en":"I'll be along shortly.","fr":"Je serai bientôt là.","before":"I'll be along ","after":".","answer":"shortly","choices":["shortly","short"],"form":"adverb"},{"id":"adverbs-manner:714599","en":"The book was published posthumously.","fr":"Le livre fut publié à titre posthume.","before":"The book was published ","after":".","answer":"posthumously","choices":["posthumously","posthumous"],"form":"adverb"},{"id":"adverbs-manner:300806","en":"He got up quickly, splashed cold water on his face, brushed his teeth, and shaved.","fr":"Il s'est vite levé, s'est aspergé le visage d'eau froide, s'est brossé les dents, et s'est rasé.","before":"He got up ","after":", splashed cold water on his face, brushed his teeth, and shaved.","answer":"quickly","choices":["quickly","quick"],"form":"adverb"},{"id":"adverbs-manner:2237591","en":"Tom reacted instinctively.","fr":"Tom a réagi instinctivement.","before":"Tom reacted ","after":".","answer":"instinctively","choices":["instinctively","instinctive"],"form":"adverb"},{"id":"adverbs-manner:7824590","en":"I want you to listen to me carefully.","fr":"Je veux que tu m'écoutes attentivement.","before":"I want you to listen to me ","after":".","answer":"carefully","choices":["carefully","careful"],"form":"adverb"},{"id":"adverbs-manner:253051","en":"I agree with him to a certain extent, but not entirely.","fr":"Je suis d'accord avec lui dans une certaine mesure, mais pas entièrement.","before":"I agree with him to a certain extent, but not ","after":".","answer":"entirely","choices":["entirely","entire"],"form":"adverb"},{"id":"adverbs-manner:8645636","en":"Listen quietly!","fr":"Écoutez bien !","before":"Listen ","after":"!","answer":"quietly","choices":["quietly","quiet"],"form":"adverb"},{"id":"adverbs-manner:2099983","en":"My tooth is making me suffer horribly.","fr":"Ma dent me fait horriblement souffrir.","before":"My tooth is making me suffer ","after":".","answer":"horribly","choices":["horribly","horrible"],"form":"adverb"},{"id":"adverbs-manner:1249701","en":"His heart beat slowly.","fr":"Son cœur battait lentement.","before":"His heart beat ","after":".","answer":"slowly","choices":["slowly","slow"],"form":"adverb"},{"id":"adverbs-manner:3127947","en":"I suggest you take this a little more seriously.","fr":"Je suggère que vous preniez cela moins légèrement.","before":"I suggest you take this a little more ","after":".","answer":"seriously","choices":["seriously","serious"],"form":"adverb"},{"id":"adverbs-manner:36203","en":"Nancy smiled happily.","fr":"Nancy souriait gaiement.","before":"Nancy smiled ","after":".","answer":"happily","choices":["happily","happy"],"form":"adverb"},{"id":"adverbs-manner:34747","en":"We were late for school because it rained heavily.","fr":"En raison de la forte pluie, nous arrivâmes trop tard à l'école.","before":"We were late for school because it rained ","after":".","answer":"heavily","choices":["heavily","heavy"],"form":"adverb"},{"id":"adverbs-manner:272063","en":"It was raining quietly.","fr":"Il pleuvait doucement.","before":"It was raining ","after":".","answer":"quietly","choices":["quietly","quiet"],"form":"adverb"},{"id":"adverbs-manner:51493","en":"Excuse me, could you say that again more slowly?","fr":"Pourriez-vous répéter cela plus lentement, je vous prie ?","before":"Excuse me, could you say that again more ","after":"?","answer":"slowly","choices":["slowly","slow"],"form":"adverb"},{"id":"adverbs-manner:291198","en":"He handled the tool skillfully.","fr":"Il maîtrisait bien l'outil.","before":"He handled the tool ","after":".","answer":"skillfully","choices":["skillfully","skillful"],"form":"adverb"},{"id":"adverbs-manner:2273057","en":"Tom is breathing normally.","fr":"Tom respire normalement.","before":"Tom is breathing ","after":".","answer":"normally","choices":["normally","normal"],"form":"adverb"},{"id":"adverbs-manner:2645134","en":"You handled that deftly.","fr":"Tu as géré ça habilement.","before":"You handled that ","after":".","answer":"deftly","choices":["deftly","deft"],"form":"adverb"},{"id":"adverbs-manner:250797","en":"Listen to me carefully, and you will understand what I really mean.","fr":"Écoutez-moi attentivement et vous comprendrez ce que je veux vraiment dire.","before":"Listen to me ","after":", and you will understand what I really mean.","answer":"carefully","choices":["carefully","careful"],"form":"adverb"},{"id":"adverbs-manner:1129468","en":"Could you wrap them up separately?","fr":"Peux-tu les emballer séparément ?","before":"Could you wrap them up ","after":"?","answer":"separately","choices":["separately","separate"],"form":"adverb"},{"id":"adverbs-manner:11721304","en":"It all went south very quickly.","fr":"Tout a dégénéré très rapidement.","before":"It all went south very ","after":".","answer":"quickly","choices":["quickly","quick"],"form":"adverb"},{"id":"adverbs-manner:2782138","en":"I slept soundly.","fr":"J'ai dormi profondément.","before":"I slept ","after":".","answer":"soundly","choices":["soundly","sound"],"form":"adverb"},{"id":"adverbs-manner:290067","en":"He took the job reluctantly.","fr":"Il a accepté ce travail à contre-cœur.","before":"He took the job ","after":".","answer":"reluctantly","choices":["reluctantly","reluctant"],"form":"adverb"},{"id":"adverbs-manner:3563785","en":"Now, listen to me carefully.","fr":"Maintenant, écoutez-moi bien !","before":"Now, listen to me ","after":".","answer":"carefully","choices":["carefully","careful"],"form":"adverb"},{"id":"adverbs-manner:250652","en":"My salary doesn't allow us to live extravagantly.","fr":"Mon salaire ne nous permet pas de vivre de façon extravagante.","before":"My salary doesn't allow us to live ","after":".","answer":"extravagantly","choices":["extravagantly","extravagant"],"form":"adverb"},{"id":"adverbs-manner:11937095","en":"I remember perfectly.","fr":"Je m'en souviens parfaitement.","before":"I remember ","after":".","answer":"perfectly","choices":["perfectly","perfect"],"form":"adverb"},{"id":"adverbs-manner:1742986","en":"Did you read it entirely?","fr":"Avez-vous tout lu ?","before":"Did you read it ","after":"?","answer":"entirely","choices":["entirely","entire"],"form":"adverb"},{"id":"adverbs-manner:312909","en":"She arranged the flowers beautifully.","fr":"Elle a magnifiquement arrangé les fleurs.","before":"She arranged the flowers ","after":".","answer":"beautifully","choices":["beautifully","beautiful"],"form":"adverb"},{"id":"adverbs-manner:780925","en":"Tonight in the night sky, the stars are shining very brightly.","fr":"Aujourd'hui dans le ciel nocturne, les étoiles semblent très brillantes.","before":"Tonight in the night sky, the stars are shining very ","after":".","answer":"brightly","choices":["brightly","bright"],"form":"adverb"}]}
